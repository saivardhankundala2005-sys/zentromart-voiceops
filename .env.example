# VoiceOps 2026 Environment Configuration Example
# Copy this file to .env and fill in your API keys

# Gnani.ai Speech API Key (https://app.gnani.ai/voice)
GNANI_API_KEY=

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# Dataset & Index Directories
DATA_DIR=Capstone_Project_Dataset_FTTT_2026/Capstone_Project_Dataset_FTTT_2026
INDEX_DIR=data_index
REFERENCE_DATE=2026-10-20

# Gnani Voice Settings
STT_LANG=en-IN
TTS_MODEL=timbre-v2.5
TTS_VOICE=Kaveri
